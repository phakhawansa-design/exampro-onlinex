# 🌐 ตั้งค่าพอร์ตสำหรับ Server
PORT=5000

# 🐘 วาง Connection String จาก Neon PostgreSQL ที่นี่ (ตัวอย่าง):
# DATABASE_URL=postgres://neondb_owner:password@ep-xyz-123456.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# 📁 ที่เก็บฐานข้อมูล ไฟล์อัปโหลด และไฟล์สำรอง (แนะนำให้อยู่นอก OneDrive)
# ถ้าไม่ใส่ จะใช้โฟลเดอร์ .data ในโปรเจคเหมือนเดิม
# DATA_DIR=C:\ExamProData

# 🔐 ระบบยืนยันตัวตน
# AUTH_SECRET=ใส่ข้อความสุ่มยาวๆ (ไม่ใส่ก็ได้ ระบบจะสร้างให้เอง)
# AUTH_TOKEN_HOURS=12
# AUTH_ENFORCE=off   ← ปิดการบังคับล็อกอินชั่วคราว ใช้เฉพาะกรณีฉุกเฉินเท่านั้น
# ADMIN_PASSWORD=รหัสผ่านแอดมินตอนสร้างระบบครั้งแรก (ไม่ใส่ = admin123 และระบบจะบังคับให้ตั้งรหัสใหม่ตอนเข้าสู่ระบบครั้งแรก)

# 💾 สำรองฐานข้อมูลอัตโนมัติ (SQLite) เก็บที่ DATA_DIR/backups
# BACKUP_KEEP=7
# BACKUP_ENABLED=off

# 🤖 Claude AI — สมัครที่ https://console.anthropic.com
# ANTHROPIC_API_KEY=sk-ant-...
# ESSAY_MODEL=claude-sonnet-5-5
# QUIZ_MODEL=claude-sonnet-5-5
# ESSAY_CONFIDENCE_THRESHOLD=0.7

# 💰 ประมาณค่าใช้จ่าย (USD ต่อ 1 ล้าน token และอัตราแลกเปลี่ยน) ตรวจราคาล่าสุดที่ anthropic.com/pricing
# ESSAY_PRICE_IN=2
# ESSAY_PRICE_OUT=10
# USD_THB=35

# 🔒 PDPA: ลบไฟล์ภาพกระดาษคำตอบอัตโนมัติหลังกี่วัน (0 = ไม่ลบ) คะแนนยังอยู่ครบ
# ESSAY_RETENTION_DAYS=180
